/* ==========================================================
   طلب تابلوه مخصص: العميل يرفع صورة ويكتب وصف، والطلب يوصلك.

   إزاي بيشتغل (ومفيش حاجة مدفوعة):
   1) الصورة بتتصغّر جوه المتصفح الأول (عشان تترفع بسرعة حتى على
      نت الموبايل).
   2) بتترفع على استضافة الصور المجانية imgbb، وبترجع رابط للصورة.
   3) الرابط ده + الاسم والهاتف والمقاس والوصف بيتبعتوا لإيميلك
      عن طريق Web3Forms، بنفس المفتاح بتاع فورم الطلب العادي.
      (Web3Forms مابيقبلش رفع ملفات في الخطة المجانية، عشان كده
      الصورة بتترفع على imgbb ويتبعت رابطها بس.)

   ⚠️ خطوة لازم تتعمل مرة واحدة: حط مفتاح imgbb في IMGBB_API_KEY تحت.
   من غير المفتاح: الوصف بيوصلك عادي، والعميل بيتعرض عليه يبعت
   الصورة على واتساب.
   ========================================================== */
(function () {
    // 👇 حط هنا مفتاح imgbb (من api.imgbb.com بعد ما تعمل حساب مجاني)
    const IMGBB_API_KEY = '';

    const WEB3FORMS_URL = 'https://api.web3forms.com/submit';
    const FALLBACK_ACCESS_KEY = '490a8acf-2b67-4b63-b6c6-41aa5f00ed09';
    const SHOP_WHATSAPP = '201003206544';
    const MAX_IMAGE_SIDE = 1600;   // أكبر بُعد للصورة بالبكسل بعد التصغير
    const JPEG_QUALITY = 0.85;

    const $ = id => document.getElementById(id);

    // المفتاح بنقراه من فورم الطلب الموجود في الصفحة عشان يفضل متزامن
    function getAccessKey() {
        const input = document.querySelector('#orderForm input[name="access_key"]');
        return (input && input.value) || FALLBACK_ACCESS_KEY;
    }

    function setStatus(text, isError) {
        const el = $('customStatus');
        if (!el) return;
        el.textContent = text || '';
        el.classList.toggle('error', !!isError);
    }

    /* ---------- فتح / قفل النافذة ---------- */
    function openCustomModal() {
        const modal = $('customModal');
        if (!modal) return;
        setStatus('');
        modal.style.display = 'flex';
        document.body.classList.add('stop-scrolling');
    }

    function closeCustomModal() {
        const modal = $('customModal');
        if (!modal) return;
        modal.style.display = 'none';
        document.body.classList.remove('stop-scrolling');
    }

    /* ---------- معاينة الصورة بعد الاختيار ---------- */
    function onImageChosen() {
        const input = $('customImage');
        const preview = $('customPreview');
        const label = $('customFileText');
        const file = input && input.files && input.files[0];

        if (!file) {
            if (preview) preview.style.display = 'none';
            if (label) label.textContent = '📷 اختر صورة التابلوه';
            return;
        }
        if (!file.type.startsWith('image/')) {
            input.value = '';
            setStatus('الملف لازم يكون صورة.', true);
            return;
        }
        setStatus('');
        if (label) label.textContent = '✔ ' + file.name + ' (دوس لتغيير الصورة)';
        if (preview) {
            if (preview.dataset.url) URL.revokeObjectURL(preview.dataset.url);
            const url = URL.createObjectURL(file);
            preview.dataset.url = url;
            preview.src = url;
            preview.style.display = 'block';
        }
    }

    /* ---------- تصغير الصورة قبل الرفع ---------- */
    function compressImage(file) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            const url = URL.createObjectURL(file);
            img.onload = () => {
                URL.revokeObjectURL(url);
                const scale = Math.min(1, MAX_IMAGE_SIDE / Math.max(img.width, img.height));
                const canvas = document.createElement('canvas');
                canvas.width = Math.round(img.width * scale);
                canvas.height = Math.round(img.height * scale);
                canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                canvas.toBlob(
                    blob => (blob ? resolve(blob) : reject(new Error('compress failed'))),
                    'image/jpeg',
                    JPEG_QUALITY
                );
            };
            img.onerror = () => {
                URL.revokeObjectURL(url);
                reject(new Error('image decode failed'));
            };
            img.src = url;
        });
    }

    /* ---------- رفع الصورة على imgbb وإرجاع الرابط المباشر ---------- */
    async function uploadToImgbb(blob) {
        const fd = new FormData();
        fd.append('image', blob, 'tableau.jpg');
        const res = await fetch(
            'https://api.imgbb.com/1/upload?key=' + encodeURIComponent(IMGBB_API_KEY),
            { method: 'POST', body: fd }
        );
        const data = await res.json();
        if (!data || !data.success || !data.data || !data.data.url) {
            throw new Error('imgbb: ' + ((data && data.error && data.error.message) || res.status));
        }
        return data.data.url;
    }

    /* ---------- الخطة البديلة: واتساب ---------- */
    function openWhatsApp(details) {
        const text =
            'طلب تابلوه مخصص من موقع تحفة\n\n' +
            'الاسم: ' + details.name + '\n' +
            'الهاتف: ' + details.phone + '\n' +
            (details.size ? 'المقاس: ' + details.size + '\n' : '') +
            'الوصف: ' + details.desc +
            (details.imageUrl ? '\n\nرابط الصورة: ' + details.imageUrl : '\n\n(هبعت الصورة هنا في الشات)');
        // location.href بدل window.open عشان المتصفحات مابتحجبهاش
        window.location.href = 'https://wa.me/' + SHOP_WHATSAPP + '?text=' + encodeURIComponent(text);
    }

    /* ---------- إرسال الطلب ---------- */
    async function submitCustomRequest() {
        const details = {
            name: $('customName').value.trim(),
            phone: $('customPhone').value.trim(),
            size: $('customSize').value.trim(),
            desc: $('customDesc').value.trim(),
            imageUrl: ''
        };
        const file = $('customImage').files[0];

        if (!details.name || !details.phone || !details.desc) {
            setStatus('برجاء كتابة الاسم ورقم الهاتف ووصف التابلوه.', true);
            return;
        }
        if (!file) {
            setStatus('برجاء اختيار صورة التابلوه.', true);
            return;
        }

        const btn = $('customSubmitBtn');
        btn.disabled = true;

        // 1) رفع الصورة (لو فشل أو المفتاح مش موجود، بنكمل بالوصف بس)
        let imageProblem = false;
        if (!IMGBB_API_KEY) {
            imageProblem = true;
        } else {
            try {
                setStatus('جاري تجهيز الصورة...');
                let blob;
                try { blob = await compressImage(file); } catch (e) { blob = file; }
                setStatus('جاري رفع الصورة...');
                details.imageUrl = await uploadToImgbb(blob);
            } catch (err) {
                console.error('فشل رفع الصورة:', err);
                imageProblem = true;
            }
        }

        // 2) إرسال الطلب لإيميلك
        setStatus('جاري إرسال الطلب...');
        const fd = new FormData();
        fd.append('access_key', getAccessKey());
        fd.append('subject', 'طلب تابلوه مخصص من موقع تحفة');
        fd.append('from_name', 'موقع تحفة');
        fd.append('الاسم', details.name);
        fd.append('الهاتف', details.phone);
        fd.append('المقاس_المطلوب', details.size || 'غير محدد');
        fd.append('وصف_التابلوه', details.desc);
        fd.append('رابط_الصورة', details.imageUrl || 'لم تُرفع - العميل هيبعتها على واتساب');

        try {
            const response = await fetch(WEB3FORMS_URL, { method: 'POST', body: fd });
            const result = await response.json();

            if (result.success) {
                if (imageProblem) {
                    setStatus('تم استلام وصف طلبك، ومحتاجين صورة التابلوه.');
                    if (confirm('تم استلام وصف طلبك ✔\nبس الصورة ماترفعتش.\n\nتحب تبعتها دلوقتي على واتساب؟')) {
                        openWhatsApp(details);
                    }
                } else {
                    $('customForm').reset();
                    onImageChosen();
                    setStatus('تم إرسال طلبك بنجاح ✔ هنتواصل معاك قريبًا.');
                    setTimeout(closeCustomModal, 2500);
                }
            } else {
                console.error('Web3Forms رفض الطلب:', result);
                setStatus('');
                if (confirm('السيرفر رفض الطلب: ' + (result.message || 'سبب غير معروف') +
                            '\n\nتحب تبعت الطلب على واتساب بدل كده؟')) {
                    openWhatsApp(details);
                }
            }
        } catch (err) {
            console.error('خطأ اتصال:', err);
            setStatus('');
            if (confirm('فشل الاتصال بالسيرفر.\n\nتحب تبعت الطلب على واتساب بدل كده؟')) {
                openWhatsApp(details);
            }
        } finally {
            btn.disabled = false;
        }
    }

    /* ---------- ربط الأحداث ---------- */
    document.addEventListener('DOMContentLoaded', () => {
        const modal = $('customModal');
        const input = $('customImage');
        if (input) input.addEventListener('change', onImageChosen);
        if (modal) {
            // الضغط على الخلفية السودا برا النافذة يقفلها
            modal.addEventListener('click', e => { if (e.target === modal) closeCustomModal(); });
        }
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCustomModal(); });
    });

    // الدوال اللي بتتنادى من onclick في الـHTML
    window.openCustomModal = openCustomModal;
    window.closeCustomModal = closeCustomModal;
    window.submitCustomRequest = submitCustomRequest;
})();